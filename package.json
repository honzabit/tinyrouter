{
  "name": "tinyrouter-gateway",
  "version": "0.1.0",
  "description": "A tiny, auditable, self-hosted LLM gateway.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --watch src/main.ts --config tinyrouter.yaml",
    "start": "bun src/main.ts --config tinyrouter.yaml",
    "check": "tsc --noEmit",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "knip": "knip",
    "test": "bun test",
    "smoke": "bun scripts/smoke.ts",
    "release": "bun scripts/release.ts",
    "build": "bun build src/main.ts --compile --outfile dist/tinyrouter"
  },
  "dependencies": {
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "1.3.14",
    "bun": "1.3.14",
    "knip": "^6.31.0",
    "type-fest": "^5.8.0",
    "typescript": "7.0.2"
  }
}
